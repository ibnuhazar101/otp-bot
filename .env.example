# --- REST server ---
# Host/port the API listens on. Default is loopback only; set 0.0.0.0 ONLY
# behind a reverse proxy / firewall (and then set TRUST_PROXY accordingly).
HOST=127.0.0.1
PORT=3000

# --- Auth (required) ---
# One or more API keys (comma separated, >= 16 chars). Generate: openssl rand -hex 32
# Clients send `Authorization: Bearer <key>` or `X-API-Key: <key>`.
API_KEY=
# Number of reverse-proxy hops (e.g. 1) so rate limits use the real client IP. Leave unset if none.
# TRUST_PROXY=
# Max OTP lookups per API key per minute.
# OTP_RATE_LIMIT_PER_MIN=30
# Local experiments only: disable auth entirely.
# AUTH_DISABLED=false

# --- IMAP ---
# IMAP host/port are normally derived per account (from the email domain, or an
# explicit "imapHost" in accounts.json). These are only fallbacks for accounts
# on an unknown domain with no imapHost set. Leave IMAP_HOST unset unless needed.
# IMAP_HOST=
IMAP_PORT=993

# --- OTP fetching (on-demand) ---
# A message's OTP only counts if it arrived within this many seconds.
# Default 600 (10 min). 0 disables the check (returns the newest match regardless
# of age — testing only; users may get an expired code).
OTP_RECENCY_SECONDS=600

# How many matching messages (per provider search) to download per request.
# With sender+subject filtering the OTP is almost always the newest one, so a
# small number keeps requests fast.
FETCH_LIMIT=3

# How long an IMAP connection is kept "warm" after a request so repeat clicks
# reuse it instead of reconnecting each time, in seconds.
WARM_CONNECTION_SECONDS=120

# Paths to the config files.
ACCOUNTS_FILE=accounts.json
PROVIDERS_FILE=providers.json
